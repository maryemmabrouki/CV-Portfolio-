<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Maryem Mabrouki — Développement Full-Stack &amp; Intelligence Artificielle | Recherche Alternance</title>
  <meta name="description"
    content="Portfolio officiel de Maryem Mabrouki. Étudiante en Master IS2IA à l'ESISA, à la recherche d'une alternance en développement logiciel, Full-Stack ou intelligence artificielle. Projets en RAG, Vision par Ordinateur, architectures web/mobiles et algorithmique.">
  <meta name="author" content="Maryem Mabrouki">
  <meta name="keywords"
    content="Maryem Mabrouki, Alternance, Full-Stack, Intelligence Artificielle, RAG, Computer Vision, C++, Algorithmique, ESISA, Fès, Maroc, FastAPI, React, Next.js, Python, Java, Power BI">

  <!-- Open Graph / Meta Réseaux Sociaux -->
  <meta property="og:title" content="Maryem Mabrouki — Développement Full-Stack &amp; Intelligence Artificielle">
  <meta property="og:description"
    content="Portfolio professionnel : Étudiante en Master IS2IA, à la recherche d'une alternance en développement logiciel, Full-Stack ou IA. Projets en RAG, vision, architectures logicielles et algorithmique.">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:url" content="https://cv-portfolio-meryam.vercel.app">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Maryem Mabrouki — Full-Stack &amp; IA | Alternance">
  <meta name="twitter:description"
    content="Portfolio officiel de Maryem Mabrouki : architectures logicielles &amp; systèmes intelligents.">

  <!-- Favicon SVG aux couleurs de l'identité prune & or -->
  <link rel="icon" type="image/svg+xml"
    href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='24' fill='%2333213F'/><text x='50%' y='63%' font-family='serif' font-weight='700' font-size='46' fill='%23B8925A' text-anchor='middle'>MM</text></svg>">

  <!-- Typographies Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700;9..144,900&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@300;400;500;600;700&display=swap"
    rel="stylesheet">

  <style>
    /* ==========================================================
       1. VARIABLES DU DESIGN SYSTEM (Harmonie Prune, Or & Lavande)
       ========================================================== */
    :root {
      --bg: #F6F4F8;
      --surface: #FFFFFF;
      --surface-alt: #FAF8FC;
      --surface-card: #FFFFFF;
      --ink: #1F1A2B;
      --ink-secondary: #4B4458;
      --muted: #6B6478;

      /* Palette Prune & Violet Royale */
      --violet-deep: #33213F;
      --violet-deep-2: #422A54;
      --violet: #6E4A94;
      --violet-strong: #573876;
      --violet-soft: #C9B8DA;
      --violet-mist: #EDE7F3;
      --violet-glow: rgba(110, 74, 148, 0.16);

      /* Accents Or Chaud (avec variante accessible WCAG AA) */
      --gold: #B8925A;
      --gold-accessible: #94682A;
      /* Contraste >= 4.5:1 sur fond clair */
      --gold-soft: #E8D9C0;
      --gold-glow: rgba(184, 146, 90, 0.25);

      /* Lignes & Bordures */
      --line: #E2DBEB;
      --line-dark: rgba(255, 255, 255, 0.12);

      /* Statut Disponible */
      --status-emerald: #10B981;
      --status-glow: rgba(16, 185, 129, 0.25);

      /* Dimensions & Rayons */
      --radius-sm: 8px;
      --radius: 14px;
      --radius-lg: 22px;
      --radius-pill: 9999px;
      --maxw: 1160px;

      /* Ombres portées */
      --shadow-sm: 0 2px 8px rgba(31, 26, 43, 0.04);
      --shadow-md: 0 8px 24px rgba(51, 33, 63, 0.08);
      --shadow-lg: 0 16px 38px rgba(51, 33, 63, 0.12);
      --shadow-glow: 0 0 25px rgba(184, 146, 90, 0.22);
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
      }
    }

    body {
      background-color: var(--bg);
      color: var(--ink-secondary);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
      transition: color 0.2s ease;
    }

    img {
      max-width: 100%;
      height: auto;
      display: block;
    }

    button,
    input,
    textarea {
      font-family: inherit;
    }

    /* Accessibilité focus clavier */
    a:focus-visible,
    button:focus-visible,
    input:focus-visible,
    textarea:focus-visible {
      outline: 2px solid var(--gold);
      outline-offset: 3px;
    }

    .wrap {
      max-width: var(--maxw);
      margin: 0 auto;
      padding: 0 1.75rem;
    }

    /* ==========================================================
       2. TYPOGRAPHIE & HIÉRARCHIE
       ========================================================== */
    h1,
    h2,
    h3,
    h4 {
      font-family: 'Fraunces', Georgia, serif;
      font-weight: 600;
      color: var(--ink);
      line-height: 1.2;
    }

    .eyebrow {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.75rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      font-weight: 600;
      color: var(--gold-accessible);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .eyebrow.on-dark {
      color: var(--gold-soft);
    }

    .section-head {
      max-width: 720px;
      margin-bottom: 2.8rem;
    }

    .section-head h2 {
      font-size: 2.35rem;
      margin-top: 0.6rem;
      color: var(--ink);
    }

    .section-head p.sub {
      color: var(--muted);
      font-size: 1.05rem;
      margin-top: 0.65rem;
      line-height: 1.6;
    }

    section {
      padding: 5.5rem 0;
      position: relative;
    }

    /* ==========================================================
       3. NAVIGATION HEADER (COMPACT & ÉLÉGANT)
       ========================================================== */
    .site-nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(246, 244, 248, 0.86);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(110, 74, 148, 0.09);
      transition: background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, padding 0.25s ease;
    }

    .site-nav.scrolled {
      background: rgba(246, 244, 248, 0.97);
      border-bottom: 1px solid rgba(184, 146, 90, 0.28);
      box-shadow: 0 2px 14px rgba(51, 33, 63, 0.06);
    }

    .site-nav .wrap {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 0.45rem;
      padding-bottom: 0.45rem;
      transition: padding 0.25s ease;
    }

    .site-nav.scrolled .wrap {
      padding-top: 0.35rem;
      padding-bottom: 0.35rem;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      text-decoration: none;
    }

    .brand-mark {
      width: 28px;
      height: 28px;
      border-radius: 7px;
      background: linear-gradient(135deg, var(--violet-deep), var(--violet-strong));
      border: 1px solid rgba(184, 146, 90, 0.35);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--gold-soft);
      font-family: 'Fraunces', serif;
      font-weight: 700;
      font-size: 0.8rem;
      box-shadow: 0 2px 6px rgba(51, 33, 63, 0.12);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      flex-shrink: 0;
    }

    .brand:hover .brand-mark {
      transform: scale(1.05);
      box-shadow: 0 3px 8px rgba(184, 146, 90, 0.3);
    }

    .brand-text {
      display: flex;
      flex-direction: column;
      line-height: 1.15;
    }

    .brand-name {
      font-family: 'Fraunces', serif;
      font-weight: 700;
      font-size: 0.92rem;
      color: var(--violet-strong);
      letter-spacing: -0.01em;
    }

    .brand-sub {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.62rem;
      color: var(--muted);
      letter-spacing: 0.03em;
    }

    .nav-links {
      display: flex;
      gap: 0.95rem;
      list-style: none;
      align-items: center;
    }

    .nav-links a {
      font-size: 0.82rem;
      font-weight: 500;
      color: var(--muted);
      padding: 0.24rem 0.45rem;
      border-radius: 5px;
      transition: color 0.18s ease, background 0.18s ease;
      position: relative;
    }

    .nav-links a:hover {
      color: var(--violet-strong);
      background: rgba(110, 74, 148, 0.06);
    }

    .nav-links a.active {
      color: var(--violet-strong);
      font-weight: 600;
      background: rgba(110, 74, 148, 0.09);
    }

    .nav-links a.active::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 50%;
      transform: translateX(-50%);
      width: 14px;
      height: 2px;
      background: var(--gold);
      border-radius: 1px;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .nav-btn-cv {
      background: transparent;
      color: var(--violet-strong);
      border: 1px solid rgba(110, 74, 148, 0.22);
      border-radius: 6px;
      padding: 0.32rem 0.72rem;
      font-size: 0.78rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .nav-btn-cv:hover {
      background: var(--violet-mist);
      border-color: var(--violet-soft);
      transform: translateY(-1px);
    }

    .nav-btn-contact {
      background: linear-gradient(135deg, #C29B63, #A88147);
      color: #1F150B;
      border: none;
      border-radius: 6px;
      padding: 0.34rem 0.82rem;
      font-size: 0.78rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      text-decoration: none;
      box-shadow: 0 2px 7px rgba(184, 146, 90, 0.22);
      transition: all 0.2s ease;
      white-space: nowrap;
    }

    .nav-btn-contact:hover {
      background: linear-gradient(135deg, #CDA66F, #B58C50);
      box-shadow: 0 4px 12px rgba(184, 146, 90, 0.35);
      transform: translateY(-1px);
    }

    .nav-toggle {
      display: none;
      background: none;
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 0.3rem;
      color: var(--violet-strong);
      cursor: pointer;
    }

    /* ==========================================================
       4. BOUTONS & BADGES
       ========================================================== */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.55rem;
      padding: 0.8rem 1.45rem;
      border-radius: var(--radius-pill);
      font-size: 0.92rem;
      font-weight: 600;
      cursor: pointer;
      border: 1px solid transparent;
      transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.22s ease, background 0.22s ease;
      text-decoration: none;
      white-space: nowrap;
    }

    .btn:hover {
      transform: translateY(-2px);
    }

    .btn-sm {
      padding: 0.5rem 1rem;
      font-size: 0.82rem;
    }

    .btn-gold {
      background: linear-gradient(135deg, #C29B63, #A88147);
      color: #1F150B;
      box-shadow: 0 4px 14px rgba(184, 146, 90, 0.3);
    }

    .btn-gold:hover {
      background: linear-gradient(135deg, #CDA66F, #B58C50);
      box-shadow: 0 6px 20px rgba(184, 146, 90, 0.45);
    }

    .btn-violet {
      background: linear-gradient(135deg, var(--violet), var(--violet-strong));
      color: #FFFFFF;
      box-shadow: 0 4px 14px rgba(110, 74, 148, 0.25);
    }

    .btn-violet:hover {
      background: linear-gradient(135deg, #7B54A3, #614083);
      box-shadow: 0 6px 20px rgba(110, 74, 148, 0.4);
    }

    .btn-ghost-light {
      background: rgba(255, 255, 255, 0.08);
      color: #F6F4F8;
      border-color: rgba(255, 255, 255, 0.24);
      backdrop-filter: blur(8px);
    }

    .btn-ghost-light:hover {
      background: rgba(255, 255, 255, 0.16);
      border-color: rgba(255, 255, 255, 0.42);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    }

    .btn-ghost-dark {
      background: transparent;
      color: var(--violet-strong);
      border-color: var(--line);
    }

    .btn-ghost-dark:hover {
      background: var(--violet-mist);
      border-color: var(--violet-soft);
    }

    .tag-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .tag {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.74rem;
      padding: 0.32rem 0.72rem;
      border-radius: var(--radius-pill);
      background: var(--violet-mist);
      color: var(--violet-strong);
      border: 1px solid var(--violet-soft);
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      transition: all 0.2s ease;
    }

    .tag:hover {
      background: #E4DAEE;
      border-color: var(--violet);
      transform: translateY(-1px);
    }

    .tag.dark {
      background: rgba(255, 255, 255, 0.1);
      color: #F6F4F8;
      border-color: rgba(255, 255, 255, 0.2);
    }

    .tag.dark:hover {
      background: rgba(255, 255, 255, 0.2);
    }

    /* ==========================================================
       5. HERO SECTION AVEC TOILE ALGORITHMIQUE & ORBITALE
       ========================================================== */
    .hero {
      position: relative;
      background: radial-gradient(circle at 72% 22%, #3E244E 0%, var(--violet-deep) 48%, #1E1225 100%);
      color: #F6F4F8;
      overflow: hidden;
      padding: 5.2rem 0 4.6rem;
    }

    .hero-bg-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 1;
    }

    .hero .wrap {
      position: relative;
      z-index: 2;
    }

    .hero-grid {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: 1.18fr 0.82fr;
      gap: 3.5rem;
      align-items: center;
    }

    /* Animation d'apparition séquentielle dans le Hero */
    .hero-copy>* {
      opacity: 0;
      transform: translateY(20px);
      animation: heroEntrance 0.75s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .hero-copy>*:nth-child(1) {
      animation-delay: 0.1s;
    }

    .hero-copy>*:nth-child(2) {
      animation-delay: 0.22s;
    }

    .hero-copy>*:nth-child(3) {
      animation-delay: 0.34s;
    }

    .hero-copy>*:nth-child(4) {
      animation-delay: 0.46s;
    }

    .hero-copy>*:nth-child(5) {
      animation-delay: 0.58s;
    }

    .hero-copy>*:nth-child(6) {
      animation-delay: 0.7s;
    }

    @keyframes heroEntrance {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Badge disponibilité ALTERNANCE (Correction majeure demandée) */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.42rem 1rem;
      border-radius: var(--radius-pill);
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.38);
      color: #93F5CA;
      font-size: 0.82rem;
      font-weight: 500;
      margin-bottom: 1.3rem;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
      backdrop-filter: blur(8px);
    }

    .pulse-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--status-emerald);
      position: relative;
    }

    .pulse-dot::after {
      content: '';
      position: absolute;
      inset: -3px;
      border-radius: 50%;
      background-color: var(--status-emerald);
      opacity: 0.6;
      animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
    }

    @keyframes ping {

      75%,
      100% {
        transform: scale(2.2);
        opacity: 0;
      }
    }

    .hero h1 {
      font-size: 3.75rem;
      line-height: 1.05;
      color: #FDFBFE;
      margin-bottom: 0.85rem;
      letter-spacing: -0.015em;
    }

    .hero h1 span.name-shimmer {
      background: linear-gradient(135deg, #FFFFFF 40%, var(--gold-soft) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: inline-block;
    }

    .hero-role-badges {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 1.4rem;
    }

    .hero-role-pill {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.86rem;
      padding: 0.32rem 0.8rem;
      border-radius: var(--radius-pill);
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.18);
      color: var(--gold-soft);
      backdrop-filter: blur(6px);
    }

    .hero p.lead {
      font-size: 1.08rem;
      line-height: 1.7;
      color: #D8CCE4;
      max-width: 580px;
      margin-bottom: 2rem;
    }

    .hero-cta-group {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
      margin-bottom: 2.2rem;
    }

    .hero-social-row {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      flex-wrap: wrap;
      padding-top: 1.2rem;
      border-top: 1px solid rgba(255, 255, 255, 0.14);
    }

    .social-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.86rem;
      color: #D9CEE6;
      transition: all 0.2s ease;
    }

    .social-link svg {
      width: 17px;
      height: 17px;
      fill: currentColor;
    }

    .social-link:hover {
      color: #FFFFFF;
      transform: translateY(-2px);
    }

    /* Photo avec animation orbitale préservée */
    .hero-photo-wrap {
      position: relative;
      width: 290px;
      height: 290px;
      margin: 0 auto;
      opacity: 0;
      transform: scale(0.92);
      animation: heroPhotoIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
    }

    @keyframes heroPhotoIn {
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    .hero-photo-wrap .ring {
      position: absolute;
      inset: -28px;
      width: calc(100% + 56px);
      height: calc(100% + 56px);
      animation: orbitalSpin 42s linear infinite;
      pointer-events: none;
    }

    @keyframes orbitalSpin {
      to {
        transform: rotate(360deg);
      }
    }

    .hero-photo {
      width: 290px;
      height: 290px;
      border-radius: 50%;
      overflow: hidden;
      border: 3px solid rgba(232, 217, 192, 0.45);
      position: relative;
      z-index: 2;
      box-shadow: 0 16px 42px rgba(0, 0, 0, 0.38);
      background-color: var(--violet-deep);
    }

    .hero-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.45s ease;
    }

    .hero-photo:hover img {
      transform: scale(1.05);
    }

    /* Bandeau de chiffres clés animés au scroll */
    .hero-metrics-strip {
      margin-top: 3.5rem;
      padding-top: 2.2rem;
      border-top: 1px solid rgba(255, 255, 255, 0.14);
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
      position: relative;
      z-index: 2;
    }

    .metric-card {
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: var(--radius);
      padding: 1.15rem 1.25rem;
      transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
    }

    .metric-card:hover {
      transform: translateY(-4px);
      border-color: rgba(184, 146, 90, 0.5);
      background: rgba(255, 255, 255, 0.09);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
    }

    .metric-num {
      font-family: 'Fraunces', serif;
      font-size: 2.1rem;
      font-weight: 700;
      color: var(--gold-soft);
      line-height: 1.1;
      margin-bottom: 0.2rem;
    }

    .metric-title {
      font-size: 0.88rem;
      font-weight: 600;
      color: #FFFFFF;
      margin-bottom: 0.15rem;
    }

    .metric-desc {
      font-size: 0.76rem;
      color: var(--violet-soft);
      line-height: 1.4;
    }

    /* ==========================================================
       6. EFFETS DE RÉVÉLATION AU DÉFILEMENT (Scroll Reveal)
       ========================================================== */
    .reveal {
      opacity: 0;
      transform: translateY(22px);
      transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1), transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .reveal.in-view {
      opacity: 1;
      transform: translateY(0);
    }

    /* ==========================================================
       7. PROFIL SECTION
       ========================================================== */
    .profil-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 3rem;
      align-items: start;
    }

    .profil-text p {
      font-size: 1.05rem;
      color: var(--ink-secondary);
      line-height: 1.7;
      margin-bottom: 1.2rem;
    }

    .qualities-grid {
      margin-top: 1.8rem;
    }

    .qualities-grid h4 {
      font-size: 0.92rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
      margin-bottom: 0.8rem;
      font-family: 'IBM Plex Mono', monospace;
    }

    .highlight-cards {
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
    }

    .highlight-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 1.4rem;
      box-shadow: var(--shadow-sm);
      display: flex;
      gap: 1.1rem;
      align-items: flex-start;
      transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

    .highlight-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
      border-color: var(--violet-soft);
    }

    .highlight-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: var(--violet-mist);
      color: var(--violet-strong);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .highlight-body h3 {
      font-size: 1.12rem;
      margin-bottom: 0.3rem;
      color: var(--ink);
    }

    .highlight-body p {
      font-size: 0.9rem;
      color: var(--muted);
      line-height: 1.5;
    }

    /* ==========================================================
       8. PROJETS SECTION (Filtres dynamiques & Cartes structurées)
       ========================================================== */
    .projects-filter-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-bottom: 2.2rem;
      align-items: center;
    }

    .filter-btn {
      padding: 0.5rem 1.1rem;
      border-radius: var(--radius-pill);
      font-size: 0.84rem;
      font-weight: 600;
      border: 1px solid var(--line);
      background: var(--surface);
      color: var(--muted);
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .filter-btn:hover {
      color: var(--violet-strong);
      border-color: var(--violet-soft);
      background: var(--violet-mist);
      transform: translateY(-1px);
    }

    .filter-btn.active {
      background: var(--violet-strong);
      color: #FFFFFF;
      border-color: var(--violet-strong);
      box-shadow: 0 4px 12px rgba(87, 56, 118, 0.25);
    }

    .projects-grid {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .project-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      padding: 2.2rem;
      box-shadow: var(--shadow-sm);
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, border-color 0.25s ease;
      position: relative;
      overflow: hidden;
    }

    .project-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lg);
      border-color: var(--violet-soft);
    }

    /* Projet vedette / Flagship (MrcLens) */
    .project-card.featured {
      background: linear-gradient(145deg, #321F3E 0%, #462A5A 60%, #54336E 100%);
      color: #F6F4F8;
      border-color: rgba(184, 146, 90, 0.38);
      box-shadow: var(--shadow-md);
    }

    .project-card.featured h3 {
      color: #FFFFFF;
    }

    .project-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
      margin-bottom: 1.2rem;
      flex-wrap: wrap;
    }

    .project-title-area {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }

    .project-card h3 {
      font-size: 1.68rem;
      letter-spacing: -0.01em;
    }

    .badge-scope {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.72rem;
      font-weight: 600;
      padding: 0.24rem 0.7rem;
      border-radius: var(--radius-pill);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .badge-solo {
      background: rgba(184, 146, 90, 0.15);
      color: #94682A;
      border: 1px solid rgba(184, 146, 90, 0.35);
    }

    .badge-algo {
      background: rgba(180, 83, 9, 0.12);
      color: #B45309;
      border: 1px solid rgba(180, 83, 9, 0.3);
    }

    .badge-team {
      background: rgba(110, 74, 148, 0.12);
      color: var(--violet-strong);
      border: 1px solid var(--violet-soft);
    }

    .project-card.featured .badge-team {
      background: rgba(255, 255, 255, 0.12);
      color: #FFFFFF;
      border-color: rgba(255, 255, 255, 0.28);
    }

    .project-date {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.8rem;
      color: var(--muted);
    }

    .project-card.featured .project-date {
      color: var(--violet-soft);
    }

    /* Blocs Structurés : Problématique vs Solution */
    .project-body-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.6rem;
      margin-bottom: 1.6rem;
    }

    .block-spec {
      background: var(--surface-alt);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 1.15rem 1.25rem;
    }

    .project-card.featured .block-spec {
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(255, 255, 255, 0.14);
    }

    .block-spec .block-title {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 600;
      margin-bottom: 0.5rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .block-spec.challenge .block-title {
      color: #C2410C;
    }

    .project-card.featured .block-spec.challenge .block-title {
      color: #FDBA74;
    }

    .block-spec.solution .block-title {
      color: var(--violet-strong);
    }

    .project-card.featured .block-spec.solution .block-title {
      color: #D8B4FE;
    }

    .block-spec p,
    .block-spec ul {
      font-size: 0.88rem;
      line-height: 1.55;
    }

    .block-spec ul {
      padding-left: 1.1rem;
      margin-top: 0.3rem;
    }

    .block-spec li {
      margin-bottom: 0.35rem;
    }

    /* Accordéon interactif pour explorer les détails sans surcharger */
    .project-details-toggle {
      background: none;
      border: none;
      color: var(--violet-strong);
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.78rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      cursor: pointer;
      padding: 0.3rem 0;
      margin-bottom: 1.2rem;
      transition: color 0.2s ease;
    }

    .project-card.featured .project-details-toggle {
      color: var(--gold-soft);
    }

    .project-details-toggle:hover {
      text-decoration: underline;
    }

    .project-details-toggle svg {
      transition: transform 0.25s ease;
    }

    .project-details-toggle.open svg {
      transform: rotate(180deg);
    }

    .project-extra-panel {
      display: none;
      background: rgba(110, 74, 148, 0.05);
      border: 1px dashed var(--violet-soft);
      border-radius: var(--radius-sm);
      padding: 1rem 1.2rem;
      font-size: 0.86rem;
      line-height: 1.6;
      margin-bottom: 1.4rem;
    }

    .project-card.featured .project-extra-panel {
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(255, 255, 255, 0.2);
    }

    .project-extra-panel.open {
      display: block;
      animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(-6px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Walkthrough interactif de pipeline pour MrcLens */
    .pipeline-interactive {
      margin-top: 1.4rem;
      padding: 1.25rem;
      border-radius: var(--radius);
      background: rgba(0, 0, 0, 0.24);
      border: 1px solid rgba(255, 255, 255, 0.14);
    }

    .pipeline-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.85rem;
    }

    .pipeline-header-title {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--gold-soft);
      display: flex;
      align-items: center;
      gap: 0.45rem;
    }

    .pipeline-nav {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.5rem;
      margin-bottom: 1rem;
    }

    .pipeline-step-btn {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: var(--radius-sm);
      padding: 0.55rem 0.4rem;
      color: #D8CCE4;
      font-size: 0.76rem;
      cursor: pointer;
      text-align: center;
      transition: all 0.2s ease;
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .pipeline-step-btn span.step-id {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.66rem;
      opacity: 0.75;
    }

    .pipeline-step-btn:hover {
      background: rgba(255, 255, 255, 0.15);
      color: #FFFFFF;
    }

    .pipeline-step-btn.active {
      background: rgba(184, 146, 90, 0.25);
      border-color: var(--gold);
      color: #FFFFFF;
      box-shadow: 0 0 14px rgba(184, 146, 90, 0.25);
    }

    .pipeline-content-box {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: var(--radius-sm);
      padding: 0.95rem 1.1rem;
      font-size: 0.84rem;
      line-height: 1.5;
      min-height: 70px;
    }

    .project-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
      padding-top: 1.1rem;
      border-top: 1px solid var(--line);
    }

    .project-card.featured .project-footer {
      border-top-color: rgba(255, 255, 255, 0.14);
    }

    .project-actions {
      display: flex;
      gap: 0.6rem;
      flex-wrap: wrap;
    }

    /* ==========================================================
       9. EXPÉRIENCES SECTION (Timeline)
       ========================================================== */
    .timeline {
      position: relative;
      padding-left: 2.2rem;
      margin-left: 0.5rem;
    }

    .timeline::before {
      content: '';
      position: absolute;
      left: 6px;
      top: 8px;
      bottom: 8px;
      width: 2px;
      background: linear-gradient(180deg, var(--gold) 0%, var(--violet-soft) 100%);
    }

    .tl-item {
      position: relative;
      padding-bottom: 3.2rem;
    }

    .tl-item:last-child {
      padding-bottom: 0;
    }

    .tl-dot {
      position: absolute;
      left: -2.2rem;
      top: 0.2rem;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--gold);
      border: 3px solid var(--bg);
      box-shadow: 0 0 0 2px var(--violet-strong);
    }

    .tl-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 1.8rem;
      box-shadow: var(--shadow-sm);
      transition: all 0.2s ease;
    }

    .tl-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
      border-color: var(--violet-soft);
    }

    .tl-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 0.5rem;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .tl-role {
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--ink);
    }

    .tl-org {
      font-weight: 600;
      color: var(--violet-strong);
      font-size: 1rem;
      margin-bottom: 0.8rem;
    }

    .tl-date-badge {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.78rem;
      padding: 0.25rem 0.65rem;
      border-radius: var(--radius-pill);
      background: var(--violet-mist);
      color: var(--violet-strong);
      font-weight: 600;
      border: 1px solid var(--violet-soft);
    }

    .tl-subject {
      background: var(--surface-alt);
      border-left: 3px solid var(--gold);
      padding: 0.65rem 0.9rem;
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
      font-size: 0.88rem;
      color: var(--ink);
      font-weight: 500;
      margin-bottom: 1rem;
    }

    .tl-bullets {
      padding-left: 1.2rem;
      margin-bottom: 1.2rem;
      color: var(--ink-secondary);
    }

    .tl-bullets li {
      margin-bottom: 0.45rem;
      font-size: 0.92rem;
    }

    /* ==========================================================
       10. COMPÉTENCES SECTION
       ========================================================== */
    .skills-controls {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 2.2rem;
    }

    .search-wrapper {
      position: relative;
      max-width: 480px;
    }

    .search-input {
      width: 100%;
      padding: 0.75rem 1rem 0.75rem 2.6rem;
      border-radius: var(--radius-pill);
      border: 1px solid var(--line);
      background: var(--surface);
      font-size: 0.9rem;
      color: var(--ink);
      transition: all 0.2s ease;
    }

    .search-input:focus {
      border-color: var(--violet);
      box-shadow: 0 0 0 3px var(--violet-glow);
      outline: none;
    }

    .search-icon {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--muted);
      pointer-events: none;
    }

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.4rem;
    }

    .skill-cat-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 1.6rem;
      box-shadow: var(--shadow-sm);
      transition: all 0.2s ease;
    }

    .skill-cat-card:hover {
      border-color: var(--violet-soft);
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
    }

    .skill-cat-head {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--line);
    }

    .skill-icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: var(--violet-mist);
      color: var(--violet-strong);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .skill-cat-title {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--ink);
      font-family: 'Inter', sans-serif;
    }

    .empty-state {
      display: none;
      text-align: center;
      padding: 3rem 1.5rem;
      background: var(--surface);
      border: 1px dashed var(--line);
      border-radius: var(--radius);
      color: var(--muted);
      font-size: 0.92rem;
    }

    /* ==========================================================
       11. FORMATION & CERTIFICATIONS
       ========================================================== */
    .formation-layout {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 2rem;
    }

    .formation-column {
      display: flex;
      flex-direction: column;
      gap: 1.4rem;
    }

    .academic-card,
    .certif-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 1.5rem;
      box-shadow: var(--shadow-sm);
      transition: all 0.2s ease;
    }

    .academic-card:hover,
    .certif-card:hover {
      border-color: var(--violet-soft);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .card-head-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 0.5rem;
      margin-bottom: 0.4rem;
    }

    .degree-name {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--ink);
    }

    .degree-school {
      color: var(--violet-strong);
      font-weight: 600;
      font-size: 0.92rem;
    }

    .certif-issuer {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--gold-accessible);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Langues officielles */
    .languages-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 1.5rem;
    }

    .lang-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--line);
    }

    .lang-item:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .lang-name {
      font-weight: 600;
      color: var(--ink);
      font-size: 0.95rem;
    }

    .lang-level {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.8rem;
      color: var(--violet-strong);
      background: var(--violet-mist);
      padding: 0.2rem 0.6rem;
      border-radius: var(--radius-pill);
      border: 1px solid var(--violet-soft);
    }

    /* ==========================================================
       12. ENGAGEMENTS & ACTIVITÉS SECTION
       ========================================================== */
    .engagements-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.3rem;
      margin-bottom: 2.5rem;
    }

    .engagement-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 1.5rem;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.2s ease;
    }

    .engagement-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
      border-color: var(--violet-soft);
    }

    .engagement-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--gold-accessible);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 0.4rem;
    }

    .engagement-card h3 {
      font-size: 1.15rem;
      margin-bottom: 0.3rem;
      line-height: 1.3;
    }

    .engagement-meta {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.76rem;
      color: var(--violet-strong);
      margin-bottom: 0.75rem;
      font-weight: 500;
    }

    .engagement-desc {
      font-size: 0.88rem;
      color: var(--muted);
      line-height: 1.55;
    }

    /* Grille centres d'intérêt & qualités */
    .hobbies-qualities-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }

    /* ==========================================================
       13. CONTACT SECTION (Sans QR code, avec liens visibles)
       ========================================================== */
    .contact-container {
      background: linear-gradient(160deg, var(--violet-deep) 0%, var(--violet-deep-2) 65%, var(--violet-strong) 100%);
      color: #F6F4F8;
      border-radius: var(--radius-lg);
      padding: 3.5rem;
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow-lg);
    }

    .contact-container h2 {
      color: #FFFFFF;
    }

    .contact-container p.sub {
      color: var(--violet-soft);
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      margin-top: 2rem;
      align-items: start;
    }

    .contact-direct {
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
    }

    .contact-card {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: var(--radius);
      padding: 1.1rem 1.3rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      backdrop-filter: blur(8px);
    }

    .contact-info {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .contact-icon {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--gold-soft);
      flex-shrink: 0;
    }

    .contact-label {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--violet-soft);
    }

    .contact-val {
      font-size: 0.98rem;
      font-weight: 600;
      color: #FFFFFF;
    }

    .btn-copy {
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: var(--radius-sm);
      padding: 0.45rem 0.8rem;
      font-size: 0.78rem;
      color: #FFFFFF;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      transition: all 0.2s ease;
    }

    .btn-copy:hover {
      background: var(--gold);
      color: #1F150B;
      border-color: var(--gold);
    }

    /* Formulaire accessible */
    .contact-form {
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .form-group label {
      font-size: 0.82rem;
      font-weight: 500;
      color: #E2D7ED;
    }

    .form-input,
    .form-textarea {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: var(--radius-sm);
      padding: 0.85rem 1rem;
      color: #FFFFFF;
      font-size: 0.92rem;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .form-input:focus,
    .form-textarea:focus {
      border-color: var(--gold);
      outline: none;
      box-shadow: 0 0 0 3px rgba(184, 146, 90, 0.25);
    }

    .form-input::placeholder,
    .form-textarea::placeholder {
      color: rgba(246, 244, 248, 0.45);
    }

    .form-textarea {
      min-height: 120px;
      resize: vertical;
    }

    /* ==========================================================
       14. FOOTER & BOUTON FLOTTANT RETOUR EN HAUT
       ========================================================== */
    footer {
      background: #171120;
      color: var(--muted);
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding: 3rem 0;
      font-size: 0.86rem;
    }

    .footer-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1.5rem;
    }

    .footer-brand {
      display: flex;
      align-items: center;
      gap: 0.8rem;
    }

    .btn-top {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: var(--radius-sm);
      padding: 0.5rem 1rem;
      color: #E2D7ED;
      font-size: 0.82rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      transition: all 0.2s ease;
    }

    .btn-top:hover {
      background: rgba(255, 255, 255, 0.15);
      color: #FFFFFF;
    }

    .floating-top-btn {
      position: fixed;
      bottom: 2rem;
      left: 2rem;
      z-index: 90;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--surface);
      color: var(--violet-strong);
      border: 1px solid var(--line);
      box-shadow: var(--shadow-md);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      opacity: 0;
      transform: translateY(16px);
      pointer-events: none;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .floating-top-btn.visible {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .floating-top-btn:hover {
      background: var(--violet-mist);
      transform: translateY(-3px);
      box-shadow: var(--shadow-lg);
    }

    /* ==========================================================
       15. TOAST DE CONFIRMATION & MODAL
       ========================================================== */
    .toast {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      z-index: 999;
      background: var(--violet-strong);
      color: #FFFFFF;
      padding: 0.9rem 1.4rem;
      border-radius: var(--radius-pill);
      box-shadow: var(--shadow-lg);
      border: 1px solid var(--violet-soft);
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.88rem;
      font-weight: 500;
      opacity: 0;
      transform: translateY(20px);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
    }

    .toast.show {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    /* Modal CV */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 1000;
      background: rgba(18, 12, 26, 0.72);
      backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
    }

    .modal-backdrop.open {
      opacity: 1;
      pointer-events: auto;
    }

    .modal-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      max-width: 520px;
      width: 100%;
      padding: 2.2rem;
      box-shadow: var(--shadow-lg);
      transform: scale(0.95);
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
    }

    .modal-backdrop.open .modal-card {
      transform: scale(1);
    }

    .modal-close {
      position: absolute;
      top: 1.2rem;
      right: 1.2rem;
      background: none;
      border: none;
      color: var(--muted);
      cursor: pointer;
      padding: 0.4rem;
    }

    .modal-close:hover {
      color: var(--ink);
    }

    /* ==========================================================
       16. RESPONSIVE DESIGN (Mobile & Tablette)
       ========================================================== */
    @media (max-width: 1024px) {
      .hero-grid {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .hero-photo-wrap {
        order: -1;
        margin-bottom: 1.5rem;
      }

      .hero p.lead {
        margin-left: auto;
        margin-right: auto;
      }

      .hero-cta-group,
      .hero-role-badges,
      .hero-social-row {
        justify-content: center;
      }

      .hero-metrics-strip {
        grid-template-columns: repeat(2, 1fr);
      }

      .profil-grid {
        grid-template-columns: 1fr;
      }

      .project-body-grid {
        grid-template-columns: 1fr;
      }

      .pipeline-nav {
        grid-template-columns: repeat(2, 1fr);
      }

      .formation-layout {
        grid-template-columns: 1fr;
      }

      .skills-grid {
        grid-template-columns: 1fr;
      }

      .engagements-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .contact-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 860px) {
      .nav-links {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: var(--bg);
        border-bottom: 1px solid var(--line);
        flex-direction: column;
        padding: 1.5rem 2rem;
        gap: 0.8rem;
        display: none;
        box-shadow: var(--shadow-md);
      }

      .nav-links.open {
        display: flex;
      }

      .nav-toggle {
        display: flex;
      }

      .nav-actions .btn-sm {
        display: none;
      }

      .hero h1 {
        font-size: 2.85rem;
      }

      .engagements-grid {
        grid-template-columns: 1fr;
      }

      .hobbies-qualities-grid {
        grid-template-columns: 1fr;
      }

      .contact-container {
        padding: 2.2rem 1.5rem;
      }

      .hero-metrics-strip {
        grid-template-columns: 1fr;
      }
    }

    @media print {

      .site-nav,
      .hero-cta-group,
      .nav-actions,
      .filter-btn,
      .btn-copy,
      .contact-form,
      footer,
      .toast,
      .floating-top-btn {
        display: none !important;
      }

      body {
        background: #fff;
        color: #000;
      }

      .hero {
        background: none;
        color: #000;
        padding: 1rem 0;
      }

      .hero h1 {
        color: #000;
      }

      .project-card,
      .tl-card,
      .skill-cat-card {
        border: 1px solid #ccc;
        box-shadow: none;
      }
    }
  </style>
</head>

<body id="top">

  <!-- Bouton flottant retour en haut -->
  <button class="floating-top-btn" id="floatingTopBtn" onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
    aria-label="Retour en haut de page">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="18 15 12 9 6 15" />
    </svg>
  </button>

  <!-- ========================================================
       BARRE DE NAVIGATION STICKY
       ======================================================== -->
  <header class="site-nav" id="siteNav">
    <div class="wrap">
      <a href="#top" class="brand" aria-label="Accueil — Maryem Mabrouki">
        <div class="brand-mark" aria-hidden="true">MM</div>
        <div class="brand-text">
          <span class="brand-name">Maryem Mabrouki</span>
          <span class="brand-sub">Full-Stack &amp; IA · ESISA</span>
        </div>
      </a>

      <nav aria-label="Navigation principale">
        <ul class="nav-links" id="navLinks">
          <li><a href="#profil">Profil</a></li>
          <li><a href="#projets">Projets</a></li>
          <li><a href="#experience">Expérience</a></li>
          <li><a href="#competences">Compétences</a></li>
          <li><a href="#formation">Formation</a></li>
          <li><a href="#engagements">Engagements</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>

      <div class="nav-actions">
        <button class="nav-btn-cv" onclick="openCvModal()" aria-label="Ouvrir le CV de Maryem Mabrouki">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          <span>CV</span>
        </button>
        <a href="#contact" class="nav-btn-contact">
          <span>Me contacter</span>
        </a>
        <button class="nav-toggle" id="navToggle" aria-label="Ouvrir le menu de navigation" aria-expanded="false">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main>
    <!-- ========================================================
         HERO SECTION (Présentation, Alternance & Chiffres clés)
         ======================================================== -->
    <section class="hero" id="heroSection">
      <!-- Toile algorithmique & courbes orbitales discrètes -->
      <canvas id="heroBgCanvas" class="hero-bg-canvas" aria-hidden="true"></canvas>

      <div class="wrap">
        <div class="hero-grid">
          <div class="hero-copy">
            <!-- Badge Statut : Recherche d'Alternance (Objectif officiel) -->
            <div class="status-badge">
              <span class="pulse-dot"></span>
              <span>À la recherche d'une alternance · Développement Logiciel, Full-Stack ou IA</span>
            </div>

            <h1><span class="name-shimmer">Maryem<br>Mabrouki</span></h1>

            <!-- Titre & Rôles -->
            <div class="hero-role-badges">
              <span class="hero-role-pill">Développement Full-Stack</span>
              <span class="hero-role-pill">Intelligence Artificielle</span>
              <span class="hero-role-pill">Systèmes RAG &amp; Vision</span>
            </div>

            <p class="lead">
              Étudiante en Master IS2IA à l’ESISA, à la recherche d'une alternance en développement logiciel, Full-Stack
              ou intelligence artificielle. Projets couvrant la conception d’applications web et mobiles ainsi que des
              systèmes intelligents : RAG, agents IA et vision par ordinateur.
            </p>

            <!-- Actions principales -->
            <div class="hero-cta-group">
              <a href="#projets" class="btn btn-gold">
                <span>Voir mes projets</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12" />
                  <polyline points="12 5 19 12 12 19" />
                </svg>
              </a>
              <button class="btn btn-ghost-light" onclick="openCvModal()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                  <polyline points="7 10 12 15 17 10" />
                  <line x1="12" y1="15" x2="12" y2="3" />
                </svg>
                <span>Télécharger mon CV</span>
              </button>
              <a href="#contact" class="btn btn-ghost-light">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path
                    d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                </svg>
                <span>Me contacter</span>
              </a>
            </div>

            <!-- Liens sociaux officiels -->
            <div class="hero-social-row">
              <a href="https://github.com/maryemmabrouki" target="_blank" rel="noopener noreferrer" class="social-link"
                title="GitHub de Maryem Mabrouki">
                <svg viewBox="0 0 24 24">
                  <path
                    d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                </svg>
                <span>maryemmabrouki</span>
              </a>
              <a href="https://linkedin.com/in/maryem-mabrouki-0058942a5" target="_blank" rel="noopener noreferrer"
                class="social-link" title="LinkedIn de Maryem Mabrouki">
                <svg viewBox="0 0 24 24">
                  <path
                    d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                </svg>
                <span>LinkedIn</span>
              </a>
              <span class="social-link" style="color:var(--gold-soft);">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                  stroke-linejoin="round">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
                <span>Fès, Maroc</span>
              </span>
            </div>
          </div>

          <!-- Photo de profil avec animation orbitale préservée -->
          <div class="hero-photo-wrap">
            <svg class="ring" viewBox="0 0 346 346" aria-hidden="true">
              <g fill="none" stroke="rgba(232, 217, 192, 0.55)" stroke-width="1.2" stroke-dasharray="1 11"
                stroke-linecap="round">
                <circle cx="173" cy="173" r="166" />
              </g>
            </svg>
            <div class="hero-photo">
              <img
                src="data:image/jpeg;base64,"
                alt="Photo de profil de Maryem Mabrouki" width="290" height="290">
            </div>
          </div>
        </div>

        <!-- Rangée de chiffres clés réels animés -->
        <div class="hero-metrics-strip" id="metricsStrip">
          <div class="metric-card">
            <div class="metric-num" data-target="93.5" data-suffix="%">93,5%</div>
            <div class="metric-title">Accuracy Vision</div>
            <div class="metric-desc">EfficientNetV2-S (24 classes patrimoine) sur MrcLens</div>
          </div>
          <div class="metric-card">
            <div class="metric-num" data-target="55" data-suffix="h">55h</div>
            <div class="metric-title">Agent IA Solo</div>
            <div class="metric-desc">Projet Kenza conçu en 55h de hackathon (Fastify/Redis)</div>
          </div>
          <div class="metric-card">
            <div class="metric-num" data-target="56" data-suffix=" Tests">56 Tests</div>
            <div class="metric-title">Tests JUnit 5</div>
            <div class="metric-desc">Suite automatisée unitaires, intégration et e2e chez Incuboster</div>
          </div>
          <div class="metric-card">
            <div class="metric-num" data-target="177" data-suffix=" Dossiers">177</div>
            <div class="metric-title">Dossiers de Diabète</div>
            <div class="metric-desc">Données CHU (période d'un mois) modélisées en BI &amp; R</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================
         SECTION PROFIL (« Ce qui me définit »)
         ======================================================== -->
    <section id="profil" class="reveal">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg>
            Profil &amp; Vision
          </p>
          <h2>Ingénierie logicielle &amp; Intelligence appliquée</h2>
          <p class="sub">Construire des systèmes complets : du code backend maintenable aux modèles intelligents en
            production.</p>
        </div>

        <div class="profil-grid">
          <div class="profil-text">
            <p>
              Actuellement étudiante en <strong>Master IS2IA</strong> (Ingénierie des Systèmes d’Information et
              Intelligence Artificielle) à l’<strong>ESISA</strong> après une <strong>Licence en Ingénierie
                Logicielle</strong>, je recherche activement une <strong>opportunité d'alternance</strong> afin de
              mettre mes compétences au service de projets concrets et stimulants.
            </p>
            <p>
              Mon travail s'articule autour de la conception d'applications web et mobiles robustes (FastAPI, Fastify,
              Node.js, Next.js, React Native, Java/JavaFX) et de leur articulation avec des briques d'intelligence
              artificielle : <strong>systèmes RAG, agents autonomes multi-outils, traitement du langage naturel, vision
                par ordinateur et algorithmique fondamentale (C++)</strong>.
            </p>
            <p>
              Chaque projet est conduit avec une exigence de modularité, de sécurité et d'impact réel pour l'utilisateur
              final — qu'il s'agisse d'un praticien hospitalier en endocrinologie ou d'un marchand marocain gérant son
              inventaire.
            </p>

            <div class="qualities-grid">
              <h4>Qualités &amp; Aptitudes d'ingénieure</h4>
              <div class="tag-row">
                <span class="tag">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  Leadership &amp; Prise d'initiative
                </span>
                <span class="tag">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  Travail en équipe
                </span>
                <span class="tag">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  Esprit d'analyse &amp; Pensée critique
                </span>
                <span class="tag">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  Adaptabilité technologique
                </span>
                <span class="tag">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  Résolution méthodique de problèmes
                </span>
              </div>
            </div>
          </div>

          <div class="highlight-cards">
            <div class="highlight-card">
              <div class="highlight-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
                  <line x1="8" y1="21" x2="16" y2="21" />
                  <line x1="12" y1="17" x2="12" y2="21" />
                </svg>
              </div>
              <div class="highlight-body">
                <h3>Double Culture Tech &amp; IA</h3>
                <p>Maîtrise des architectures en couches (MVC, Clean Architecture), des bases relationnelles
                  (PostgreSQL, SQLite) et NoSQL (MongoDB, Redis), et des flux temps réel (WebSockets, BullMQ).</p>
              </div>
            </div>

            <div class="highlight-card">
              <div class="highlight-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="3" />
                  <path
